### 3. **JavaScript Functionality**

```javascript
// Get calendar elements
const daysContainer = root_element.querySelector("#calendar-days");
const monthYearDisplay = root_element.querySelector("#month-year");
const prevButton = root_element.querySelector("#prev-month");
const nextButton = root_element.querySelector("#next-month");

let currentDate = new Date();

// Render the calendar
function renderCalendar(date) {
    const year = date.getFullYear();
    const month = date.getMonth();
    const today = new Date();

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    monthYearDisplay.textContent = `${date.toLocaleString("default", {
        month: "long",
    })} ${year}`;

    daysContainer.innerHTML = "";

    for (let i = 0; i < firstDay; i++) {
        const blankDay = document.createElement("div");
        blankDay.classList.add("calendar-day");
        blankDay.style.visibility = "hidden"; // Hide blank days
        daysContainer.appendChild(blankDay);
    }

    for (let day = 1; day <= daysInMonth; day++) {
        const dayElement = document.createElement("div");
        dayElement.classList.add("calendar-day");
        if (
            today.getDate() === day &&
            today.getMonth() === month &&
            today.getFullYear() === year
        ) {
            dayElement.classList.add("today");
        }
        dayElement.textContent = day;
        dayElement.addEventListener("click", () =>
            alert(`You clicked on ${day}-${month + 1}-${year}`)
        );
        daysContainer.appendChild(dayElement);
    }
}

// Change month
function changeMonth(offset) {
    currentDate.setMonth(currentDate.getMonth() + offset);
    renderCalendar(currentDate);
}

// Event listeners
prevButton.addEventListener("click", () => changeMonth(-1));
nextButton.addEventListener("click", () => changeMonth(1));

// Initial render
renderCalendar(currentDate);
```

#### Explanation:
1. **Initialization**:
   - `currentDate`: Tracks the currently displayed month.
   - Event listeners are added to the navigation buttons.

2. **`renderCalendar` Function**:
   - Clears existing calendar days.
   - Populates the calendar grid with days of the month.
   - Adds a `today` highlight if the date matches the current date.
   - Adds click listeners to day elements to handle user interaction.

3. **`changeMonth` Function**:
   - Updates the `currentDate` to the next or previous month and re-renders the calendar.

